generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum GoalType {
  LOSE_WEIGHT
  MAINTAIN_WEIGHT
  GAIN_MUSCLE
}

enum GoalCategory {
  WEIGHT
  WORKOUT_FREQUENCY
  CALORIE_INTAKE
  MUSCLE_GAIN
  ENDURANCE
  OTHER
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum WorkoutType {
  CARDIO
  STRENGTH
  FLEXIBILITY
  HIIT
  YOGA
  OTHER
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  waterGoal  Int      @default(2000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  isCoach         Boolean        @default(false)
  coachCode       String?        @unique
  coachProfile    CoachProfile?
  coachedStudents CoachStudent[] @relation("CoachRelation")
  myCoaches       CoachStudent[] @relation("StudentRelation")

  coachedPrograms  Program[]           @relation("CoachPrograms")
  studentPrograms  ProgramAssignment[] @relation("StudentPrograms")
  assignedByMe     ProgramAssignment[] @relation("AssignedBy")
  progressLogs     ProgramProgress[]   @relation("StudentProgress")

  profile          Profile?
  mealLogs         MealLog[]
  workoutLogs      WorkoutLog[]
  weightLogs       WeightLog[]
  waterLogs        WaterLog[]
  workouts         Workout[]
  nutritionLogs    NutritionLog[]
  goals            Goal[]
  bodyMeasurements BodyMeasurement[]
  reminders        Reminder[]
  challenges       Challenge[]
}

model CoachProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  bio         String?
  specialty   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CoachStudent {
  id        String   @id @default(cuid())
  coachId   String
  studentId String
  coach     User     @relation("CoachRelation", fields: [coachId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)
  status    String   @default("ACTIVE")
  joinedAt  DateTime @default(now())

  @@unique([coachId, studentId])
  @@index([coachId])
  @@index([studentId])
}

model Program {
  id            String   @id @default(cuid())
  coachId       String
  coach         User     @relation("CoachPrograms", fields: [coachId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  type          String   @default("WEEKLY")
  durationWeeks Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  days        ProgramDay[]
  assignments ProgramAssignment[]

  @@index([coachId])
}

model ProgramDay {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayNumber Int
  label     String
  notes     String?
  order     Int      @default(0)

  exercises ProgramExercise[]
  progresses ProgramProgress[]

  @@index([programId])
}

model ProgramExercise {
  id       String     @id @default(cuid())
  dayId    String
  day      ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  name     String
  sets     Int?
  reps     Int?
  weight   Float?
  restTime Int?
  notes    String?
  order    Int        @default(0)

  progressLogs ProgramProgressExercise[]

  @@index([dayId])
}

model ProgramAssignment {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentPrograms", fields: [studentId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation("AssignedBy", fields: [coachId], references: [id], onDelete: Cascade)
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  createdAt DateTime @default(now())

  progresses ProgramProgress[]

  @@index([studentId])
  @@index([coachId])
  @@index([programId])
}

model ProgramProgress {
  id           String            @id @default(cuid())
  assignmentId String
  assignment   ProgramAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User              @relation("StudentProgress", fields: [studentId], references: [id], onDelete: Cascade)
  dayId        String
  day          ProgramDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  date         DateTime          @db.Date
  status       String            @default("IN_PROGRESS")
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  exercises ProgramProgressExercise[]

  @@unique([assignmentId, dayId, date])
  @@index([studentId])
  @@index([assignmentId])
  @@index([date])
}

model ProgramProgressExercise {
  id           String          @id @default(cuid())
  progressId   String
  progress     ProgramProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     ProgramExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  completed    Boolean         @default(false)
  actualSets   Int?
  actualReps   Int?
  actualWeight Float?
  timeSpent    Int?
  notes        String?
  order        Int             @default(0)

  @@index([progressId])
}

model Profile {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  age           Int
  height        Float
  weight        Float
  gender        Gender
  activityLevel ActivityLevel
  goal          GoalType
  targetWeight  Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model FoodItem {
  id        String  @id @default(cuid())
  name      String
  nameFa    String
  brand     String?
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  fiber     Float   @default(0)
  isCustom  Boolean @default(false)
  createdBy String?

  mealLogItems MealLogItem[]
}

model MealLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mealType  MealType
  createdAt DateTime @default(now())

  items MealLogItem[]

  @@unique([userId, date, mealType])
}

model MealLogItem {
  id         String   @id @default(cuid())
  mealLogId  String
  mealLog    MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])
  quantity   Float
}

model Exercise {
  id          String  @id @default(cuid())
  name        String
  nameFa      String
  category    String
  metValue    Float
  muscleGroup String?
  description String?

  workoutLogItems WorkoutLogExercise[]
}

model WorkoutLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  totalDuration Int
  totalCalories Float
  notes         String?
  createdAt     DateTime @default(now())

  exercises WorkoutLogExercise[]
}

model WorkoutLogExercise {
  id           String     @id @default(cuid())
  workoutLogId String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise   @relation(fields: [exerciseId], references: [id])
  sets         Int?
  reps         Int?
  duration     Int?
  weight       Float?
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  weight    Float
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  amount    Int
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model Workout {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String?
  description    String?
  type           WorkoutType
  duration       Int
  date           DateTime    @default(now())
  caloriesBurned Int?
  notes          String?
  isTemplate     Boolean     @default(false)
  isCompleted    Boolean     @default(false)
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  exercises WorkoutExercise[]
}

model WorkoutExercise {
  id        String   @id @default(cuid())
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  sets      Int?
  reps      Int?
  weight    Float?
  duration  Int?
  restTime  Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model NutritionLog {
  id        String   @id @default(cuid())
  userId    String
  foodName  String
  calories  Int
  protein   Float?
  carbs     Float?
  fat       Float?
  mealType  MealType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id           String       @id @default(cuid())
  userId       String
  title        String
  description  String?
  goalType     GoalCategory
  targetValue  Float
  currentValue Float        @default(0)
  deadline     DateTime?
  status       GoalStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyMeasurement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  neck      Float?
  chest     Float?
  waist     Float?
  hips      Float?
  bicep     Float?
  forearm   Float?
  thigh     Float?
  calf      Float?
  shoulder  Float?
  wrist     Float?
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
}


model Reminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String?
  type      String   @default("CUSTOM")
  time      String
  days      String   @default("ALL")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Challenge {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  emoji        String          @default("🎯")
  type         String          @default("CUSTOM")
  targetDays   Int
  currentDays  Int             @default(0)
  startDate    DateTime        @default(now())
  lastCheckIn  DateTime?
  checkInDates String          @default("")
  status       ChallengeStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}